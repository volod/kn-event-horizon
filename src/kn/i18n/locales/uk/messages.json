  "cli.identity_shown": "\u0406\u0434\u0435\u043d\u0442\u0438\u0447\u043d\u0456\u0441\u0442\u044c {kn_id} | \u041a\u043b\u0430\u0441 {entity_class} | {state}\n\u041e\u043f\u043e\u0440\u043d\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 {anchor} | \u041f\u043e\u0434\u0456\u044f \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f {mint_event}",
  "cli.identity_shown_successors": "\u041d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a\u0438 {successors}",
  "cli.lineage_help": "\u043f\u0440\u043e\u0441\u0442\u0435\u0436\u0438\u0442\u0438 \u043e\u0431'\u0454\u043a\u0442 \u0430\u0431\u043e \u043f\u043e\u043b\u0435 \u0434\u043e \u0439\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0456\u0432 \u0456 \u0440\u0456\u0448\u0435\u043d\u044c",
  "cli.lineage_reference_help": "KN ID \u0430\u0431\u043e \u043a\u0432\u0430\u043b\u0456\u0444\u0456\u043a\u043e\u0432\u0430\u043d\u0438\u0439 \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u043e\u0440 NAMESPACE:VALUE",
  "cli.lineage_field_help": "\u043f\u043e\u043a\u0430\u0437\u0430\u0442\u0438 \u043b\u0438\u0448\u0435 \u0446\u0435\u0439 \u0441\u0442\u0430\u0431\u0456\u043b\u044c\u043d\u0438\u0439 \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u043e\u0440 \u043f\u043e\u043b\u044f",
  "cli.lineage_audience_help": "\u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0456\u044f, \u043a\u0430\u043d\u043e\u043d\u0456\u0447\u043d\u0456 \u0444\u0430\u043a\u0442\u0438 \u044f\u043a\u043e\u0457 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u043e (\u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c: internal)",
  "cli.lineage_permit_help": "\u0437\u0430\u044f\u0432\u0430 \u043f\u0440\u043e \u043f\u0440\u0430\u0432\u0430, \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0430\u0443\u0434\u0438\u0442\u043e\u0440\u0456\u0457; \u043f\u043e\u0432\u0442\u043e\u0440\u0456\u0442\u044c \u0434\u043b\u044f \u043a\u043e\u0436\u043d\u043e\u0457 (\u0437\u0430 \u0437\u0430\u043c\u043e\u0432\u0447\u0443\u0432\u0430\u043d\u043d\u044f\u043c: \u0443\u0441\u0456)",
  "cli.lineage_heading": "\u041f\u043e\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f {reference}: {kn_id} \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0454\u0442\u044c\u0441\u044f \u044f\u043a {terminals}",
  "cli.lineage_scope": "\u041f\u043e\u043b\u0435 {field} | \u0410\u0443\u0434\u0438\u0442\u043e\u0440\u0456\u044f {audience} | \u041f\u0440\u0430\u0432\u0430 {permitted}",
