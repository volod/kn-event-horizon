  "cli.identity_retire_help": "\u0432\u0438\u0432\u0435\u0441\u0442\u0438 \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u0439 \u043e\u0431'\u0454\u043a\u0442 \u0437 \u043e\u0431\u0456\u0433\u0443 \u0442\u0430 \u0437\u0430\u043a\u0440\u0438\u0442\u0438 \u0439\u043e\u0433\u043e \u0437\u0432'\u044f\u0437\u043a\u0438",
  "cli.identity_restore_help": "\u0432\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u043e\u0431'\u0454\u043a\u0442, \u0432\u0438\u0432\u0435\u0434\u0435\u043d\u0438\u0439 \u0437 \u043e\u0431\u0456\u0433\u0443, \u0431\u0435\u0437 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a\u0430",
  "cli.identity_reclassify_help": "\u0432\u0438\u0432\u0435\u0441\u0442\u0438 \u043e\u0431'\u0454\u043a\u0442 \u0437 \u043e\u0431\u0456\u0433\u0443 \u0442\u0430 \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a\u0430 \u0456\u043d\u0448\u043e\u0433\u043e \u043a\u043b\u0430\u0441\u0443",
  "cli.identity_id_help": "\u043a\u0430\u043d\u043e\u043d\u0456\u0447\u043d\u0438\u0439 \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u043e\u0440 kn: UUIDv7",
  "cli.identity_request_help": "\u0443\u043d\u0456\u043a\u0430\u043b\u044c\u043d\u0438\u0439 \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u043e\u0440 \u0437\u0430\u043f\u0438\u0442\u0443, \u0442\u043e\u0439 \u0441\u0430\u043c\u0438\u0439 \u0434\u043b\u044f \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0457 \u0441\u043f\u0440\u043e\u0431\u0438",
  "cli.identity_time_help": "\u0447\u0430\u0441 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0438 \u0443 \u0444\u043e\u0440\u043c\u0430\u0442\u0456 ISO 8601 \u0437 \u044f\u0432\u043d\u0438\u043c \u0437\u043c\u0456\u0449\u0435\u043d\u043d\u044f\u043c \u0432\u0456\u0434 UTC",
  "cli.identity_reason_help": "\u043f\u0440\u0438\u0447\u0438\u043d\u0430 \u0437\u043c\u0456\u043d\u0438 \u0456\u0434\u0435\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0456",
  "cli.identity_evidence_help": "\u043f\u043e\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u043d\u0430 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u043d\u0456 \u0434\u043e\u043a\u0430\u0437\u0438",
  "cli.identity_survivor_help": "KN ID \u043e\u0431'\u0454\u043a\u0442\u0430, \u044f\u043a\u0438\u0439 \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u044c\u0441\u044f",
  "cli.identity_successors_help": "KN ID \u0449\u043e\u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0435 \u0434\u0432\u043e\u0445 \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u0445 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a\u0456\u0432",
  "cli.identity_assign_help": "\u0445\u0435\u0448 \u043f\u043e\u0434\u0456\u0457 \u0437\u0430\u043f\u0438\u0441\u0443 \u0442\u0430 \u0439\u043e\u0433\u043e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a \u0443 \u0444\u043e\u0440\u043c\u0430\u0442\u0456 ITEM=KN_ID, \u043e\u043a\u0440\u0435\u043c\u043e \u0434\u043b\u044f \u043a\u043e\u0436\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443",
  "cli.identity_class_help": "\u043a\u043b\u0430\u0441 \u0441\u0443\u0442\u043d\u043e\u0441\u0442\u0456 \u043d\u043e\u0432\u043e\u0433\u043e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0438\u043a\u0430",
  "cli.identity_anchor_source_help": "\u0434\u0436\u0435\u0440\u0435\u043b\u043e \u043d\u043e\u0432\u043e\u0433\u043e \u043e\u043f\u043e\u0440\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443",
  "cli.identity_anchor_key_help": "\u0432\u043b\u0430\u0441\u043d\u0438\u0439 \u043a\u043b\u044e\u0447 \u043d\u043e\u0432\u043e\u0433\u043e \u043e\u043f\u043e\u0440\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0441\u0443",
  "cli.identity_auth_error": "E_IDENTITY_AUTH: \u0432\u043b\u0430\u0441\u043d\u0438\u043a \u0436\u0443\u0440\u043d\u0430\u043b\u0443 \u043c\u0430\u0454 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438 \u0437\u043c\u0456\u043d\u0443 \u0432 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0442\u0435\u0440\u043c\u0456\u043d\u0430\u043b\u0456.",
  "cli.identity_confirm": "\u0420\u0435\u0446\u0435\u043d\u0437\u0435\u043d\u0442 {reviewer}. \u0412\u0432\u0435\u0434\u0456\u0442\u044c {approval}, \u0449\u043e\u0431 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0438 \u0437\u043c\u0456\u043d\u0443 \u0456\u0434\u0435\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0456.\n{proposal}",
  "cli.identity_applied": "\u0417\u043c\u0456\u043d\u0443 \u0456\u0434\u0435\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0456 \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u043e. \u0420\u0456\u0448\u0435\u043d\u043d\u044f {decision_id}.\n{event}",
  "cli.identity_resolved": "\u041a\u0456\u043d\u0446\u0435\u0432\u0456 \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0442\u043e\u0440\u0438 \u0434\u043b\u044f {kn_id}: {successors}.",
  "cli.identity_event_history": "\u0406\u0441\u0442\u043e\u0440\u0456\u044f \u0456\u0434\u0435\u043d\u0442\u0438\u0447\u043d\u043e\u0441\u0442\u0456 \u0434\u043b\u044f {kn_id}",
