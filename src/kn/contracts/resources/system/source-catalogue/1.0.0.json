{
  "apiVersion": "v3.1.0",
  "kind": "DataContract",
  "id": "kn.system.source_catalogue",
  "name": "KN source catalogue",
  "version": "1.0.0",
  "status": "draft",
  "customProperties": [
    {
      "property": "kn.storageSchema",
      "value": "system"
    }
  ],
  "schema": [
    {
      "name": "source_catalogue",
      "logicalType": "object",
      "physicalType": "table",
      "description": "Source discovery and lifecycle catalogue. Catalogue rows confer no execution authority.",
      "properties": [
        {
          "name": "source_id",
          "logicalType": "string",
          "required": true,
          "primaryKey": true,
          "description": "The stable domain-qualified catalogue identifier",
          "customProperties": [
            {
              "property": "kn.fieldId",
              "value": "system.source_catalogue.source_id"
            }
          ]
        },
        {
          "name": "domain",
          "logicalType": "string",
          "required": true,
          "primaryKey": false,
          "description": "The owning knowledge domain",
          "customProperties": [
            {
              "property": "kn.fieldId",
              "value": "system.source_catalogue.domain"
            },
            {
              "property": "kn.enum",
              "value": [
                "space",
                "microelectronics",
                "gdelt"
              ]
            }
          ]
        },
        {
          "name": "original_id",
          "logicalType": "string",
          "required": false,
          "primaryKey": false,
          "description": "Native proposal identifier when the sheet supplies one",
          "customProperties": [
            {
              "property": "kn.fieldId",
              "value": "system.source_catalogue.original_id"
            }
          ]
        },
        {
          "name": "label",
          "logicalType": "string",
          "required": true,
          "primaryKey": false,
          "description": "Original proposal resource name in the source language",
          "customProperties": [
            {
              "property": "kn.fieldId",
              "value": "system.source_catalogue.label"
            }
          ]
        },
        {
          "name": "priority",
          "logicalType": "string",
          "required": true,
          "primaryKey": false,
          "description": "Original proposal priority for investigation",
          "customProperties": [
            {
              "property": "kn.fieldId",
              "value": "system.source_catalogue.priority"
            },
            {
              "property": "kn.enum",
              "value": [
                "P0",
                "P1",
                "P2"
              ]
            }
          ]
        },
        {
          "name": "cadence",
          "logicalType": "string",
          "required": true,
          "primaryKey": false,
          "description": "Original cadence as stated in the proposal",
          "customProperties": [
            {
              "property": "kn.fieldId",
              "value": "system.source_catalogue.cadence"
            }
          ]
        },
        {
          "name": "access_notes_json",
          "logicalType": "string",
          "required": true,
          "primaryKey": false,
          "description": "Canonical JSON of provisional access and limitation cells",
          "customProperties": [
            {
              "property": "kn.fieldId",
              "value": "system.source_catalogue.access_notes_json"
            }
          ]
        },
        {
          "name": "access_verification",
          "logicalType": "string",
          "required": true,
          "primaryKey": false,
          "description": "Verification status of the proposal access notes",
          "customProperties": [
            {
              "property": "kn.fieldId",
              "value": "system.source_catalogue.access_verification"
            },
            {
              "property": "kn.enum",
              "value": [
                "unverified"
              ]
            }
          ]
        },
        {
          "name": "lifecycle_state",
          "logicalType": "string",
          "required": true,
          "primaryKey": false,
          "description": "Lifecycle designation, independent of execution approval",
          "customProperties": [
            {
              "property": "kn.fieldId",
              "value": "system.source_catalogue.lifecycle_state"
            },
            {
              "property": "kn.enum",
              "value": [
                "candidate",
                "investigating",
                "sampling_authorized",
                "approved",
                "enabled",
                "paused",
                "retired",
                "rejected"
              ]
            }
          ]
        },
        {
          "name": "proposal_workbook",
          "logicalType": "string",
          "required": true,
          "primaryKey": false,
          "description": "Original workbook file name",
          "customProperties": [
            {
              "property": "kn.fieldId",
              "value": "system.source_catalogue.proposal_workbook"
            }
          ]
        },
        {
          "name": "proposal_sheet",
          "logicalType": "string",
          "required": true,
          "primaryKey": false,
          "description": "Original workbook sheet name",
          "customProperties": [
            {
              "property": "kn.fieldId",
              "value": "system.source_catalogue.proposal_sheet"
            }
          ]
        },
        {
          "name": "proposal_sha256",
          "logicalType": "string",
          "required": true,
          "primaryKey": false,
          "description": "SHA-256 of the original proposal workbook",
          "customProperties": [
            {
              "property": "kn.fieldId",
              "value": "system.source_catalogue.proposal_sha256"
            }
          ]
        },
        {
          "name": "proposal_row",
          "logicalType": "integer",
          "required": true,
          "primaryKey": false,
          "description": "One-based row number in the original workbook",
          "customProperties": [
            {
              "property": "kn.fieldId",
              "value": "system.source_catalogue.proposal_row"
            }
          ]
        },
        {
          "name": "proposal_values_json",
          "logicalType": "string",
          "required": true,
          "primaryKey": false,
          "description": "All proposal cells as canonical JSON including source text and nulls",
          "customProperties": [
            {
              "property": "kn.fieldId",
              "value": "system.source_catalogue.proposal_values_json"
            }
          ]
        }
      ]
    }
  ]
}
