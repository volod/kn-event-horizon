# Copy to .env for local overrides. Relative paths resolve from the project root.
DATA_DIR=.data

# Leave unset or use auto. The shared bootstrap selects copy only across filesystems.
# UV_LINK_MODE=auto

# Application logging level.
LOG_LEVEL=INFO

# Local database service (make db-up). Never put a password in this file.
# Superuser password file. When unset, make db-up creates $DATA_DIR/secrets/postgres-password
# with a random value. It takes effect only when an empty database volume is initialized.
# KN_POSTGRES_PASSWORD_FILE=
# Host port of the database, published on 127.0.0.1 only. The non-standard default leaves 5432
# to another PostgreSQL on the same host.
# KN_POSTGRES_HOST_PORT=15432
# Compose project name. A second checkout on the same host needs another project name, another
# KN_POSTGRES_HOST_PORT, and its own DATA_DIR.
# COMPOSE_PROJECT_NAME=kn-event-horizon
