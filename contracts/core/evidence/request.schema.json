{
  "$defs": {
    "KeyPart": {
      "additionalProperties": false,
      "properties": {
        "field_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Field Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "date",
            "timestamp"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "field_id",
        "kind",
        "value"
      ],
      "title": "KeyPart",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "contract_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Contract Id",
          "type": "string"
        },
        "dataset": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Dataset",
          "type": "string"
        },
        "key": {
          "items": {
            "$ref": "#/$defs/KeyPart"
          },
          "minItems": 1,
          "title": "Key",
          "type": "array"
        },
        "scope": {
          "enum": [
            "record",
            "field"
          ],
          "title": "Scope",
          "type": "string"
        },
        "field_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Id"
        },
        "version": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Version",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "factual",
            "publication",
            "terminology",
            "integrity",
            "workflow"
          ],
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "dataset",
        "key",
        "scope",
        "version",
        "purpose"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Request Id",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/Target"
    },
    "outcome": {
      "enum": [
        "accept",
        "reject",
        "revoke",
        "supersede"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "performed_at": {
      "format": "date-time",
      "title": "Performed At",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Reason",
      "type": "string"
    },
    "evidence": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Evidence",
      "type": "string"
    },
    "predecessors": {
      "default": [],
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Predecessors",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "target",
    "outcome",
    "performed_at",
    "reason",
    "evidence"
  ],
  "title": "Request",
  "type": "object"
}
